# serializer version: 1
# name: TestMetricConversion.test_derived_metric_nested
  '''
  version: 0.3.0.dev0
  name: semantic_model
  datasets:
  - name: orders
    source: schema.table
    fields:
    - name: revenue
      expression:
        sql: amount
    - name: cost
      expression:
        sql: cost_amount
    - name: expenses
      expression:
        sql: expense_amount
  metrics:
  - name: revenue
    expression:
      sql: SUM(orders.revenue)
  - name: cost
    expression:
      sql: SUM(orders.cost)
  - name: expenses
    expression:
      sql: SUM(orders.expenses)
  - name: gross_profit
    expression:
      sql: SUM(orders.revenue) - SUM(orders.cost)
  - name: net_profit
    expression:
      sql: (SUM(orders.revenue) - SUM(orders.cost)) - SUM(orders.expenses)
  
  '''
# ---
# name: TestMetricConversion.test_ratio_metric_inlines_sub_expressions
  '''
  version: 0.3.0.dev0
  name: semantic_model
  datasets:
  - name: orders
    source: schema.table
    fields:
    - name: revenue
      expression:
        sql: amount
    - name: order_count
      expression:
        dialects:
        - dialect: ANSI_SQL
          expression: CASE WHEN order_id IS NOT NULL THEN 1 ELSE 0 END
    - name: order_id
      expression:
        sql: order_id
  metrics:
  - name: revenue
    expression:
      sql: SUM(orders.revenue)
  - name: order_count
    expression:
      dialects:
      - dialect: ANSI_SQL
        expression: SUM(CASE WHEN orders.order_id IS NOT NULL THEN 1 ELSE 0 END)
  - name: arpu
    expression:
      dialects:
      - dialect: ANSI_SQL
        expression: (SUM(orders.revenue)) / NULLIF(SUM(CASE WHEN orders.order_id IS
          NOT NULL THEN 1 ELSE 0 END), 0)
  
  '''
# ---
# name: TestMetricFilterFlattening.test_metric_and_measure_filters_combined_with_and
  '''
  version: 0.3.0.dev0
  name: semantic_model
  datasets:
  - name: orders
    source: schema.table
    fields:
    - name: revenue
      expression:
        sql: amount
  metrics:
  - name: paid_intl_revenue
    expression:
      sql: SUM(CASE WHEN (status = 'paid') AND (region = 'intl') THEN orders.revenue
        END)
  
  '''
# ---
# name: TestRelationshipConversion.test_three_datasets_produce_all_pairs
  '''
  version: 0.3.0.dev0
  name: semantic_model
  datasets:
  - name: users_a
    source: schema.table
    primary_key:
    - user
    fields:
    - name: user
      expression:
        sql: user_id
  - name: users_b
    source: schema.table
    unique_keys:
    - - user
    fields:
    - name: user
      expression:
        sql: user_id
  - name: orders
    source: schema.table
    fields:
    - name: user
      expression:
        sql: user_id
  relationships:
  - name: users_a__users_b__user
    from: users_a
    to: users_b
    from_columns:
    - user
    to_columns:
    - user
  - name: orders__users_a__user
    from: orders
    to: users_a
    from_columns:
    - user
    to_columns:
    - user
  - name: orders__users_b__user
    from: orders
    to: users_b
    from_columns:
    - user
    to_columns:
    - user
  
  '''
# ---
